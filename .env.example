# ==========================================================
# Genome Mentor 🧬 - Google Cloud Services Configuration
# ==========================================================
# In Vite, client-side environment variables must be prefixed with VITE_.
# Both formats are supported by Genome Mentor:

# 0. Google Gemini Generative AI Key (Optional for Live Assistant)
VITE_GOOGLE_API_KEY=AIzaSyMockGeminiKey1234567890abcdef
GOOGLE_API_KEY=AIzaSyMockGeminiKey1234567890abcdef

# 1. Firebase API Key (Web App Client Key)
VITE_FIREBASE_API_KEY=AIzaSyMockFirebaseKey9834kdL0927xLKMnz982
FIREBASE_API_KEY=AIzaSyMockFirebaseKey9834kdL0927xLKMnz982

# 2. Google Sheets API Key (Read/Write Data API)
VITE_SHEETS_API_KEY=AIzaSyMockSheetsKey11029348xLmQzP
SHEETS_API_KEY=AIzaSyMockSheetsKey11029348xLmQzP

# 3. Google Cloud Vision API Key (Image & Wireframe Analyzer)
VITE_VISION_API_KEY=AIzaSyMockVisionKey98721345vTqR
VISION_API_KEY=AIzaSyMockVisionKey98721345vTqR

# 4. Google Maps API Key (Public demo prototyping key without billing required)
VITE_MAPS_API_KEY=AIzaSyDemoKeyForPrototypingAndDevelopment
MAPS_API_KEY=AIzaSyDemoKeyForPrototypingAndDevelopment
